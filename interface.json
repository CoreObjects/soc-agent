      "summary": "禁用一个 AD 用户账号(拒绝登录；已签发 TGT 到期前仍有效)",
      "target": {
        "kind": "account",
        "key_field": "sam",
        "extra_keys": [
          "domain"
        ]
      },
      "params": [
        {
          "name": "sam",
          "type": "string",
          "required": true,
          "source": "entity_role"
        },
        {
          "name": "domain",
          "type": "string",
          "required": false,
          "source": "entity_role"
        }
      ],
      "preconditions": [
        "target_exists",
        "not_never_touch",
        "in_scope"
      ],
      "effect": "置 userAccountControl ACCOUNTDISABLE；不影响现有会话",
      "gating": "gated",
      "blast_radius": "single_target",
      "risk_default": "high",
      "idempotent": true,
      "idempotency_key": [
        "primitive",
        "sam",
        "domain"
      ],
      "reversible": {
        "mode": "full",
        "inverse": "enable_account",
        "inverse_param_map": {
          "sam": "sam",
          "domain": "domain"
        }
      },
      "rollback_handle_schema": {
        "execution_id": "str",
        "primitive": "str",
        "target": {
          "sam": "str",
          "domain": "str"
        },
        "prev_state": {
          "was_enabled": "bool"
        }
      },
      "failure_modes": [
        {
          "code": "TARGET_NOT_FOUND",
          "retriable": false
        },
        {
          "code": "WINRM_UNREACHABLE",
          "retriable": true
        },
        {
          "code": "SCOPE_DENIED",
          "retriable": false
        }
      ],
      "enforcement_point": "winrm",
      "execution": "sync",
      "audit_fields": [
        "execution_id",
        "actor",
        "approver",
        "ts",
        "params",
        "result",
        "rollback_handle"
      ]
