# 复制为 .env 后填入真实值。.env 不入库（见 .gitignore）。
# 下列为占位示例，请勿在本文件写入任何真实密钥 / 地址。
# 本 agent 只跟【图】+【本地 LLM】交互，不碰 SIEM/ES（取证只从图取）。

# --- 本地大模型 (qwen, OpenAI 兼容, 无 key) ---
LLM_API_BASE=            # 例 http://<server2>:8000/v1
LLM_API_KEY=EMPTY        # vLLM 无 key，填占位 EMPTY
LLM_MODEL=qwen32b-ft

# --- 图数据库 (Neo4j, server1) ---
NEO4J_URI=               # 例 bolt://<server1>:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=          # 可空（默认库）

# --- 研判参数（可选） ---
MAX_ITERATIONS=12        # 慢通道单次研判最大 tool-calling 轮数
# SKILLS_DIR=            # 可空，默认仓库内 skills/

# --- 第二类经验库 (openGauss, 研判机本地原生 5432, 非 docker) ---
# 空 OG_HOST → 经验层降级为"永远走 LLM"(慢研判/处置不受影响)
OG_HOST=                 # 例 127.0.0.1（研判机本地原生 openGauss）
OG_PORT=5432
OG_DATABASE=soc
OG_USER=soc              # 例 soc_agent（需先在库里建好该角色 + schema 授权）
OG_PASSWORD=
OG_SCHEMA=soc            # 建表用 schema（public 权限被拒时用自建 schema）

# --- 处置面 appliance (HTTP, 靶场那台) ---
# 空 RESPONSE_URL → 处置退回图台账队列 + range-runner 通道
RESPONSE_URL=            # 例 http://<range>:8765（靶场处置面常驻服务）
RESPONSE_TOKEN=          # 靶场 62-appliance-serve.sh 生成的 token

# --- 处置护栏 NEVER-TOUCH (可选, 逗号分隔) ---
# 受保护主机名单(DC/网关/mgmt 等);图里 is_dc/CA 角色的主机会自动进名单,这里补图外的
# DISPOSITION_PROTECTED_HOSTS=
# 受保护账号名单(缺省已含 krbtgt/administrator/domain admins/enterprise admins/domain controllers)
# DISPOSITION_PROTECTED_ACCOUNTS=
