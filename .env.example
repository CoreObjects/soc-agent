# 复制为 .env 后填入真实值。.env 不入库（见 .gitignore）。
# 下列为占位示例，请勿在本文件写入任何真实密钥 / 地址。
# 本 agent 只跟【图】+【本地 LLM】交互，不碰 SIEM/ES（取证只从图取）。

# --- 本地大模型 (qwen, OpenAI 兼容, 无 key) ---
LLM_API_BASE=            # 例 http://<server2>:8000/v1
LLM_API_KEY=EMPTY        # vLLM 无 key，填占位 EMPTY
LLM_MODEL=qwen32b-ft

# --- 图数据库 (Neo4j, server1) ---
NEO4J_URI=               # 例 bolt://<server1>:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=          # 可空（默认库）

# --- 研判参数（可选） ---
MAX_ITERATIONS=12        # 慢通道单次研判最大 tool-calling 轮数
# SKILLS_DIR=            # 可空，默认仓库内 skills/

# --- daemon（P5' 自动轮询研判，可选，均有默认值）---
# DAEMON_POLL_INTERVAL_S=10    # 每轮轮询间隔秒
# DAEMON_BATCH_SIZE=20         # 每轮取多少条未研判告警
# DAEMON_SETTLE_S=120          # settle 窗口 Δ：只研判 arrival 早于 now-Δ 的（等佐证事实到齐）
# DAEMON_TECHNIQUES=T1558.003,T1003.001  # 范围闸：逗号分隔，只自动研判有签名覆盖的 technique（留空=全放开，含无签名类型都烧 LLM）；加一类签名就往这加一个
# DAEMON_MAX_ATTEMPTS=3        # 同一告警连败几次 → 写兜底 verdict 死信、不再重选
# DAEMON_SLOW_CONCURRENCY=1    # 慢通道在飞上限（单弱 vLLM 建议 1）
