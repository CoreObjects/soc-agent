      核对连通:PYTHONPATH=. .venv312/bin/python -c "from soc_agent.config import Config;
                from soc_agent.graph.client import Neo4jGraph as G;
                c=Config.from_env();g=G(c.neo4j_uri,c.neo4j_user,c.neo4j_password,c.neo4j_database);
