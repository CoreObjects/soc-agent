=== poller-fix-restart  TMO=300 CONC=32  2026-07-29 03:07Z ===
-- .env 现值(注:本脚本不改 LLM_MODEL,沿用 .env;要换模型用 use-27b.sh)--
LLM_MODEL=qwen3.5-27b
POLLER_CONCURRENCY=32
LLM_TIMEOUT=300
-- 强杀旧 poller(清掉卡死的 worker)--
-- 起新 poller(新 QwenClient:每次新连接、读超时 300s)--
  PID=999363
-- 180s 进度验证(深度研判是多轮 agent、每条几分钟,窗口必须够长才准)--
  180s 内:新研判 77 条,新增毒告警 0  → 约 25.7/分钟
  ✅ 在动(数字在涨)
-- 日志末尾 --
